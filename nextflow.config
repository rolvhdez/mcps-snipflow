docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    container = 'rolvhdez/snipflow:v0.0.22'
    executor = 'local' // For DNAnexus, you'll change this to 'dx'
    resourceLimits = [
//        cpus: 64, // can use all cores
//        memory: 252.GB, // machine has 256GB
//        time: 12.h
        cpus: 8, // can use all cores
        memory: 10.GB, // machine has 256GB
        time: 12.h
    ]
}

params {
    bed = null
    bim = null
    fam = null
    baseline = null
    kinship = null
    pcs = null
    phenoIndex = null
    chr_range = '1-22'
    estimator = 'regular'
    outDir = './results'
}